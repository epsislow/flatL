use native csv
use native list

#main
  fp = file.createCtx('le.csv')
  wid = csv.writer(fp)
  csv.setEncoding(wid, 'UTF-16-LE')
  csv.setLineEndings(wid, 'LF')
  list.pack('n', 'v') -> hdr
  list.pack('one', '1') -> row
  list.pack(hdr, row) -> rows
  csv.writeRows(wid, rows)
  csv.close(wid)
  file.close(fp)
  fp = file.readCtx('le.csv')
  rid = csv.reader(fp)
  line = csv.next(rid)
  list.get(line, 0) -> a
  a == 'n'
  list.get(line, 1) -> b
  b == 'v'
  line = csv.next(rid)
  list.get(line, 1) -> val
  val == '1'
  csv.close(rid)
  file.close(fp)
  fp = file.createCtx('be.csv')
  wid = csv.writer(fp)
  csv.setEncoding(wid, 'UTF-16-BE')
  csv.setLineEndings(wid, 'LF')
  csv.writeRows(wid, rows)
  csv.close(wid)
  file.close(fp)
  fp = file.readCtx('be.csv')
  rid = csv.reader(fp)
  csv.next(rid) -> _
  csv.next(rid) -> row2
  list.get(row2, 0) -> c
  c == 'one'
  csv.close(rid)
  file.close(fp)
  io.outln('writer-utf16-ok')
  OK