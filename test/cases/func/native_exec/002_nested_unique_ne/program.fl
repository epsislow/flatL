use "../../../../../blocks/native-exec.fl" as #ne_
use native executor with E
use native vcx with V
use native math with m

func:executor #ne_executor.unique.scope
func:callVM 1

def double(a) -> r
  m.calc('a * 2') -> r
  return

def bump(a) -> r
  double(a) -> t
  double(t) -> r
  return

#main
  bump(3) -> x
  io.outln(x)
  OK