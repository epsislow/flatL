use "../../../../blocks/executor.fl" as #fl_
use native math with m
use native vcx with V

func:executor #fl_executor.global.scope

def pick(x ; "fast") -> r
  r = x
  return

def pick(x ; "slow") -> r
  m.calc('x * 2') -> r
  return

#main
  pick(4 ; "fast") -> a
  pick(4 ; "slow") -> b
  io.outln(a)
  io.outln(b)
  OK
