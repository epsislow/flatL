use "../../../../blocks/executor.fl" as #fl_
use native vcx with V
use native math with m

func:executor #fl_executor.unique.scope
func:callVM 1

def leaf(a) -> r
  m.calc('a * 2') -> r
  return

def mid(a) -> r
  leaf(a) -> r
  return

def bump(a) -> r
  mid(a) -> r
  return

#main
  bump(3) -> x
  io.outln(x)
  OK
