use "../../../../blocks/native-exec.fl" as #ne_
use native vcx with V
use native math with m

func:executor #ne_executor.unique.scope
func:callVM 1

def inner(a) -> r
  m.calc('a + 1') -> r
  return

def outer(a) -> r
  inner(a) -> t
  inner(t) -> r
  return

#main
  s = 0
  for(6000, i, '#iter')
  io.outln(s)
  OK

#iter
  outer(s) -> s
  next