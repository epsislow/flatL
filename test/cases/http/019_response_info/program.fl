use native obj
use native list
#main
  req = http.create('GET', 'http://mock.local/users')
  http.send(req)
  info = http.responseInfo(req)
  obj.get(info, '"status"') -> status
  obj.get(info, '"errorCode"') -> code
  obj.get(info, '"bodyLen"') -> bl
  obj.get(info, '"error"') -> err
  obj.get(info, '"headers"') -> hdrs
  obj.get(hdrs, '"content-type"') -> cts
  io.outln(status)
  io.outln(code)
  io.outln(bl)
  io.outln(err)
  io.outln(list.get(cts, 0))
  body = http.responseBody(req)
  io.outln(str.len(body))
  http.close(req)
  OK
