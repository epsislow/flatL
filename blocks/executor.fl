use native vcx with V
use native list with L
#executor.unique.scope
  instrId = V.callInstr()
  calleVcx = V.var(instrId, 'calleVcx')
  funcVcxSeed = V.var(instrId, 'funcVcxSlots')
  paramSrc = V.var(instrId, 'paramSrcNames')
  paramDst = V.var(instrId, 'funcParamNames')
  funcVcx = V.createAuto(funcVcxSeed)
  V.varsCopyByNames(instrId, funcVcx, paramSrc, paramDst)
  V.varsCopyByNames(instrId, funcVcx, ['targetBlock'], ['__run_block'])
  V.varsCopyByNames(instrId, funcVcx, ['calleVcx'], ['__calle_id'])
  V.set(funcVcx)
  call block __run_block
  V.set(V.var(V.callInstr(), 'calleVcx'))
  retSrcN = V.var(V.callInstr(), 'returnVar')
  retDstN = V.var(V.callInstr(), 'calleReturnVar')
  retSrcL = L.pack(retSrcN)
  retDstL = L.pack(retDstN)
  V.varsCopyByNames(funcVcx, V.var(V.callInstr(), 'calleVcx'), retSrcL, retDstL)
  V.set(V.var(V.callInstr(), 'calleVcx'))
  V.destroy(funcVcx)
  V.set(V.var(V.callInstr(), 'calleVcx'))
  V.destroy(V.callInstr())
  return

#executor.global.scope
  instrId = V.callInstr()
  calleVcx = V.var(instrId, 'calleVcx')
  paramSrc = V.var(instrId, 'paramSrcNames')
  paramDst = V.var(instrId, 'funcParamNames')
  V.varsCopyByNames(instrId, calleVcx, paramSrc, paramDst)
  runId = V.var(instrId, 'targetBlock')
  call block runId
  V.set(calleVcx)
  V.destroy(V.callInstr())
  return
