-- Minimal HTTPS GET — works with native flvm/flatl (libcurl) and fleditor WASM.
-- Uses a public JSON demo API that allows browser CORS.
use native http
#main
  req = http.create('GET', 'https://jsonplaceholder.typicode.com/todos/1')
  http.timeout(req, 15000)
  http.send(req)
  http.transportOk(req)
  http.statusOk(req)
  io.outln(http.status(req))
  io.outln(http.responseBody(req))
  http.close(req)
  OK
