# Emscripten build for fleditor (browser). Requires `emcc` on PATH.
# Output: docs/fleditor_site/wasm/flatl.js + flatl.wasm

EMCC       ?= emcc
WASM_DIR   = docs/fleditor_site/wasm
WASM_JS    = $(WASM_DIR)/flatl.js

WASM_CFLAGS = -Wall -Wextra -std=c11 -Iinclude -DFLAT_WASM_BUILD -D_GNU_SOURCE -O2
WASM_LDFLAGS = \
  -s MODULARIZE=1 \
  -s EXPORT_NAME=FlatLModule \
  -s ENVIRONMENT=web,node \
  -s FILESYSTEM=1 \
  -s ALLOW_MEMORY_GROWTH=1 \
  -s STACK_SIZE=8388608 \
  -s ASYNCIFY=1 \
  -s ASYNCIFY_STACK_SIZE=1048576 \
  -s 'ASYNCIFY_IMPORTS=[emscripten_sleep]' \
  -s 'EXPORTED_FUNCTIONS=[_flat_wasm_compile,_flat_wasm_compile_entry,_flat_wasm_run,_flat_wasm_run_source,_flat_wasm_run_entry,_flat_wasm_get_last_termination,_flat_wasm_get_last_panic,_flat_wasm_toolchain_version,_flat_wasm_set_run_limits,_flat_wasm_free,_malloc,_free]' \
  -s 'EXPORTED_RUNTIME_METHODS=[ccall,cwrap,UTF8ToString,getValue,setValue,HEAPU8,Asyncify,FS]' \
  -lm

STR_SRC = src/common/flat_str.c
PORT_SRC = src/port/flat_port_posix.c
FB_SRC = src/common/fb_format.c

WASM_MATH = src/lib/mod_math_trig.c src/lib/mod_math_stats.c src/lib/mod_math.c \
            src/lib/flat_math_calc.c src/lib/mod_list.c src/lib/mod_obj.c src/lib/mod_vcx.c \
            src/lib/mod_vcx_dschema.c

NATIVE_VM_SRC = src/lib/native_registry.c src/lib/native_util.c src/lib/native_dispatch.c \
                src/lib/flat_date.c src/lib/mod_io.c src/lib/mod_str.c src/lib/mod_json.c \
                src/lib/mod_date.c src/lib/mod_mem.c \
                src/lib/mod_file.c \
                $(WASM_MATH) src/lib/native_plugin_host.c

VM_SRC = src/common/vm.c src/common/doc_lookup.c src/common/flat_number.c src/common/value_pool.c \
         src/common/flat_file.c src/common/flat_io_ctx.c src/common/flat_memstream.c \
         src/common/value_collection.c \
         src/common/value_live.c src/common/flat_dynamic_bind.c src/common/value_ops.c \
         src/common/flat_obj_path.c src/common/flat_vcx.c \
         src/common/value_parse.c \
         src/common/value_format.c src/common/value_io.c src/common/value_json.c $(STR_SRC) \
         $(NATIVE_VM_SRC)

FGIR_SRC = src/common/parse.c src/common/link.c src/common/compile.c src/common/flat_func.c \
           src/common/flat_assign.c src/common/flat_slot_type.c src/common/flat_schema.c \
           src/common/line_label.c src/common/flat_jump_block.c src/common/native_use.c

WASM_SRC = src/fleditor_wasm/flat_wasm.c src/fleditor_wasm/flat_wasm_io.c \
           $(FGIR_SRC) $(FB_SRC) $(VM_SRC) $(PORT_SRC)

.PHONY: fleditor-wasm fleditor-wasm-clean

fleditor-wasm: $(WASM_JS)
	@echo "OK: $(WASM_JS) $(WASM_DIR)/flatl.wasm"

$(WASM_DIR):
	mkdir -p $(WASM_DIR)

$(WASM_JS): $(WASM_SRC) | $(WASM_DIR)
	$(EMCC) $(WASM_CFLAGS) $(WASM_SRC) -o $(WASM_JS) $(WASM_LDFLAGS)

fleditor-wasm-clean:
	rm -f $(WASM_DIR)/flatl.js $(WASM_DIR)/flatl.wasm
