# Emscripten build for fleditor (browser). Requires `emcc` on PATH.
# Output: docs/fleditor_site/wasm/flatl.js + flatl.wasm

EMCC       ?= emcc
WASM_DIR   = docs/fleditor_site/wasm
WASM_JS    = $(WASM_DIR)/flatl.js

# Optional modules (same as top-level Makefile): http=0 env=0 dom_compile=0 | dom=0
http ?= 1
# Default matches native Makefile: bundled Lexbor. WASM still requires dom_compile=1
# when DOM is enabled (no system Lexbor path).
dom_compile ?= 1
ifeq ($(dom_compile),1)
dom ?= 1
else
dom ?= 0
endif
ifeq ($(dom),0)
WASM_DOM_CFLAGS = -DFLAT_WITH_DOM=0
DOM_SRC =
else
ifeq ($(dom_compile),1)
WASM_DOM_CFLAGS = -DFLAT_WITH_DOM=1 -DFLAT_DOM_BUNDLED
DOM_SRC = src/lib/mod_dom.c
else
$(error WASM DOM requires dom_compile=1; use bundled Lexbor)
endif
endif
ifeq ($(http),0)
WASM_HTTP_CFLAGS = -DFLAT_WITH_HTTP=0
HTTP_SRC =
else
WASM_HTTP_CFLAGS =
HTTP_SRC = src/lib/mod_http.c src/common/flat_http_boundary.c src/http/flat_http_fetch.c
endif
env ?= 1
ifeq ($(env),0)
WASM_ENV_CFLAGS = -DFLAT_WITH_ENV=0
ENV_SRC =
else
WASM_ENV_CFLAGS =
ENV_SRC = src/lib/mod_env.c src/common/flat_env.c
endif
path ?= 1
ifeq ($(path),0)
WASM_PATH_CFLAGS = -DFLAT_WITH_PATH=0
PATH_SRC =
else
WASM_PATH_CFLAGS =
PATH_SRC = src/lib/mod_path.c
endif
fs ?= 1
ifeq ($(fs),0)
WASM_FS_CFLAGS = -DFLAT_WITH_FS=0
FS_SRC =
else
WASM_FS_CFLAGS =
FS_SRC = src/lib/mod_fs.c src/common/flat_fs.c
endif
enc ?= 1
ifeq ($(enc),0)
WASM_ENC_CFLAGS = -DFLAT_WITH_ENC=0
ENC_SRC =
else
WASM_ENC_CFLAGS =
ENC_SRC = src/lib/mod_enc.c
endif
re_compile ?= 1
ifeq ($(re_compile),1)
re ?= 1
else
re ?= 0
endif
ifeq ($(re),0)
WASM_RE_CFLAGS = -DFLAT_WITH_RE=0
RE_SRC =
else
ifeq ($(re_compile),1)
WASM_RE_CFLAGS = -DFLAT_WITH_RE=1 -DFLAT_RE_BUNDLED
RE_SRC = src/lib/mod_re.c src/lib/flat_re_pcre2.c
else
$(error WASM re requires re_compile=1; use bundled PCRE2 in external/pcre2)
endif
endif
hash ?= 1
ifeq ($(hash),0)
WASM_HASH_CFLAGS = -DFLAT_WITH_HASH=0
HASH_SRC =
else
WASM_HASH_CFLAGS = -Iexternal/hash
HASH_SRC = src/lib/mod_hash.c src/common/flat_hash.c \
	external/hash/WjCryptLib_Md5.c external/hash/WjCryptLib_Sha1.c \
	external/hash/WjCryptLib_Sha256.c external/hash/WjCryptLib_Sha512.c
endif
bytes ?= 1
ifeq ($(bytes),0)
WASM_BYTES_CFLAGS = -DFLAT_WITH_BYTES=0
BYTES_SRC =
else
WASM_BYTES_CFLAGS =
BYTES_SRC = src/lib/mod_bytes.c
endif
FLAT_PATH_SRC = src/common/flat_path.c
FLAT_ENC_SRC = src/common/flat_enc.c

# Quiet progress (same as top-level Makefile). V=1 → full emcc command lines.
V ?= 0
ifneq ($(V),1)
MAKEFLAGS += -s --no-print-directory
endif
ifeq ($(V),1)
step_begin = :
step_end = :
else
step_begin = printf '  %-20s ' "$(1)"
step_end = echo OK
endif

WASM_CFLAGS = -Wall -Wextra -std=c11 -Iinclude -DFLAT_WASM_BUILD -D_GNU_SOURCE -O2 $(WASM_HTTP_CFLAGS) $(WASM_DOM_CFLAGS) $(WASM_ENV_CFLAGS) $(WASM_PATH_CFLAGS) $(WASM_FS_CFLAGS) $(WASM_ENC_CFLAGS) $(WASM_RE_CFLAGS) $(WASM_HASH_CFLAGS) $(WASM_BYTES_CFLAGS)
WASM_LDFLAGS = \
  -s MODULARIZE=1 \
  -s EXPORT_NAME=FlatLModule \
  -s ENVIRONMENT=web,node \
  -s FILESYSTEM=1 \
  -s ALLOW_MEMORY_GROWTH=1 \
  -s STACK_SIZE=8388608 \
  -s ASYNCIFY=1 \
  -s ASYNCIFY_STACK_SIZE=1048576 \
  -s 'ASYNCIFY_IMPORTS=[emscripten_sleep,flat_http_fetch_sync_js]' \
  -s 'EXPORTED_FUNCTIONS=[_flat_wasm_compile,_flat_wasm_compile_entry,_flat_wasm_disassemble_entry,_flat_wasm_run,_flat_wasm_run_source,_flat_wasm_run_entry,_flat_wasm_get_last_termination,_flat_wasm_get_last_panic,_flat_wasm_toolchain_version,_flat_wasm_mods,_flat_wasm_set_run_limits,_flat_wasm_env_clear,_flat_wasm_env_set,_flat_wasm_env_args_clear,_flat_wasm_env_args_push,_flat_wasm_path_sep_set,_flat_wasm_path_sep_reset,_flat_wasm_free,_malloc,_free]' \
  -s 'EXPORTED_RUNTIME_METHODS=[ccall,cwrap,UTF8ToString,getValue,setValue,HEAPU8,Asyncify,FS]' \
  -lm

STR_SRC = src/common/flat_str.c
PORT_SRC = src/port/flat_port_posix.c
FB_SRC = src/common/fb_format.c

WASM_MATH = src/lib/mod_math_trig.c src/lib/mod_math_stats.c src/lib/mod_math_mdim.c \
            src/lib/mod_math.c src/lib/flat_math_calc.c src/lib/mod_list.c src/lib/mod_list_values_to.c \
            src/lib/mod_obj.c \
            src/lib/mod_csv.c \
            src/lib/mod_vcx.c \
            src/lib/mod_vcx_dschema.c src/lib/mod_executor.c

NATIVE_VM_SRC = src/lib/native_registry.c src/lib/native_capability.c src/lib/native_util.c src/lib/native_parse_rhs.c \
                src/lib/native_dispatch.c src/lib/mod_task.c src/lib/mod_channel.c \
                src/lib/flat_date.c src/lib/mod_io.c src/lib/mod_str.c src/lib/mod_json.c src/lib/mod_json_query.c \
                src/lib/mod_date.c src/lib/mod_mem.c \
                src/lib/mod_file.c $(HTTP_SRC) $(DOM_SRC) $(ENV_SRC) $(PATH_SRC) $(FS_SRC) $(ENC_SRC) $(RE_SRC) $(HASH_SRC) $(BYTES_SRC) $(FLAT_PATH_SRC) $(FLAT_ENC_SRC) src/lib/native_mods.c \
                $(WASM_MATH) src/lib/native_plugin_host.c

VM_SRC = src/common/flat_locale.c src/common/flat_runtime_log.c src/common/flat_host_config.c \
         src/common/flat_channel.c src/common/flat_scheduler_sync.c src/common/flat_runtime.c \
         src/common/flat_vm_handle.c src/common/flat_time.c src/common/vm.c src/common/doc_lookup.c \
         src/common/flat_number.c src/common/value_pool.c \
         src/common/flat_file.c src/common/flat_csv.c src/common/flat_csv_runtime.c \
         src/common/flat_io_ctx.c src/common/flat_memstream.c \
         src/common/value_collection.c \
         src/common/value_live.c src/common/flat_dynamic_bind.c src/common/value_ops.c \
         src/common/flat_lit.c src/common/flat_rng.c \
         src/common/flat_obj_path.c src/common/flat_vcx.c src/common/flat_executor.c \
         src/common/value_parse.c \
         src/common/value_format.c src/common/value_io.c src/common/flat_native_tag_common.c \
         src/common/flat_native_tag_runtime.c \
         src/common/value_json.c $(STR_SRC) \
         $(NATIVE_VM_SRC)

FGIR_SRC = src/common/fgir.c src/common/parse.c src/common/link.c src/common/compile.c src/common/flat_func.c \
           src/common/flat_func_tag.c \
           src/common/flat_assign.c src/common/flat_slot_type.c src/common/flat_list_typed.c \
           src/common/flat_list_shape.c \
           src/common/flat_schema.c \
           src/common/line_label.c src/common/flat_jump_block.c src/common/native_use.c \
           src/common/flat_native_tag_validate.c

WASM_SRC = src/fleditor_wasm/flat_wasm.c src/fleditor_wasm/flat_wasm_io.c src/common/flat_disasm.c \
           $(FGIR_SRC) $(FB_SRC) $(VM_SRC) $(PORT_SRC)

.PHONY: fleditor-wasm fleditor-wasm-clean

fleditor-wasm: $(WASM_JS)

$(WASM_DIR):
	@mkdir -p $(WASM_DIR)

$(WASM_JS): $(WASM_SRC) | $(WASM_DIR)
	@$(call step_begin,fleditor-wasm)
	$(EMCC) $(WASM_CFLAGS) $(WASM_SRC) -o $(WASM_JS) $(WASM_LDFLAGS)
	@$(call step_end)

fleditor-wasm-clean:
	@$(call step_begin,fleditor-wasm-clean)
	rm -f $(WASM_DIR)/flatl.js $(WASM_DIR)/flatl.wasm
	@$(call step_end)
