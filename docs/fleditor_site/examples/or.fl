use native math with m

#main
  io.in_num("Val of A:") -> A
  io.out("A = ")
  io.outln(A)
  A == 2 #.Anot2
  io.outln('A is 2. in main')
  call #common

#common
  B = m.calc('A * 2')
  io.out('B = ')
  io.outln(B)
  io.outln('----')
  OK

#or.#main.Anot2
  A == 3 #.Anot2or3
  io.outln('A is 3!')
  call #common

#or.#Anot2or3
  io.outln('A is not 2 nor 3!')
  call #common
